# Токен Telegram-бота от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Публичный HTTPS-адрес для WebApp (например, полученный через ngrok)
WEBAPP_URL=https://your-ngrok-domain.ngrok-free.app

# Настройки HTTP-сервера для Mini App и API
HOST=0.0.0.0
PORT=8080

# Часовой пояс по умолчанию
TIMEZONE=Europe/Moscow

# Время ежедневной рассылки сводки (по умолчанию 10:00)
DIGEST_HOUR=10
DIGEST_MINUTE=0
